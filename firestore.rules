rules_version = '2';
// الصق الملف ده في Firebase Console > Firestore > Rules ثم Publish. جرّبه في Rules Playground.
service cloud.firestore { match /databases/{db}/documents {
  function signed() { return request.auth != null; }
  function role() { return get(/databases/$(db)/documents/users/$(request.auth.uid)).data.role; }
  function staff() { return signed() && exists(/databases/$(db)/documents/users/$(request.auth.uid)) && role() in ['owner','admin','staff']; }
  function admin() { return signed() && exists(/databases/$(db)/documents/users/$(request.auth.uid)) && role() in ['owner','admin']; }
  function owner() { return signed() && exists(/databases/$(db)/documents/users/$(request.auth.uid)) && role() == 'owner'; }
  function lastMsg() { return request.resource.data.msgs[request.resource.data.msgs.size() - 1]; }
  // رسالة العميل لازم تكون w == 'c' وبحجم معقول، فمحدش يقدر يتنكّر في شكل موظف
  function goodClientMsg() { return request.resource.data.msgs.size() == resource.data.msgs.size() + 1 && lastMsg().w == 'c' && lastMsg().keys().hasOnly(['w','t','at']) && lastMsg().t is string && lastMsg().t.size() <= 1000; }
  function onlyMsgs() { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['msgs']); }

  match /config/owner {                       // أول واحد يسجّل بيبقى المالك الوحيد
    allow read: if signed();
    // حماية إضافية (اختيارية لكن مُوصى بيها): بدّل الإيميل بإيميلك والغي علامة التعليق عشان محدش غيرك يقدر يبقى المالك
    // allow create: if signed() && request.resource.data.uid == request.auth.uid && request.auth.token.email == 'YOUR-EMAIL@gmail.com' && request.auth.token.email_verified == true;
    allow create: if signed() && request.resource.data.uid == request.auth.uid;
    allow update: if owner();
  }
  match /users/{uid} {
    allow read: if signed() && (request.auth.uid == uid || staff());
    allow create: if signed() && request.auth.uid == uid &&
      (request.resource.data.role == 'client' ||
       (request.resource.data.role == 'owner' && getAfter(/databases/$(db)/documents/config/owner).data.uid == uid));
    allow update: if signed() && (
      (request.auth.uid == uid && request.resource.data.role == resource.data.role && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['data','diagAt'])) ||
      owner() ||
      (admin() && resource.data.role in ['client','staff'] && request.resource.data.role in ['client','staff']));
  }
  match /site/main { allow read: if true; allow write: if admin(); }          // محتوى الموقع العام
  match /site/private { allow read: if signed(); allow write: if admin(); }   // طرق الدفع ومحتوى المنتجات
  match /leads/{id} {                                                       // الطلب السريع من الزوار
    allow create: if request.resource.data.keys().hasOnly(['id','name','svc','st','amt','files','info','lead','ts'])
      && request.resource.data.name is string && request.resource.data.name.size() < 100
      && request.resource.data.st == 0 && request.resource.data.amt == 0
      && request.resource.data.svc is string && request.resource.data.svc.size() < 100 && request.resource.data.info.size() <= 25;
    allow read, update, delete: if staff();
  }
  match /orders/{id} {
    allow create: if signed() && (staff() || (request.resource.data.uid == request.auth.uid && request.resource.data.st == 0 && request.resource.data.amt == 0));
    allow read: if signed() && (resource.data.uid == request.auth.uid || staff());
    allow update: if signed() && (staff() || (resource.data.uid == request.auth.uid && onlyMsgs() && goodClientMsg()));
    allow delete: if staff();
  }
  match /transfers/{id} {
    allow create: if signed() && request.resource.data.uid == request.auth.uid && request.resource.data.st == 0 && request.resource.data.ref is string;
    allow read: if signed() && (resource.data.uid == request.auth.uid || staff());
    allow update: if staff();
  }
  match /support/{uid} {
    allow read: if signed() && (request.auth.uid == uid || staff());
    allow create: if signed() && request.auth.uid == uid && request.resource.data.keys().hasOnly(['uid','email','msgs']) && request.resource.data.msgs.size() == 1 && request.resource.data.msgs[0].w == 'c' && request.resource.data.msgs[0].t is string && request.resource.data.msgs[0].t.size() <= 1000;
    allow update: if signed() && onlyMsgs() && ((request.auth.uid == uid && goodClientMsg()) || (staff() && lastMsg().w == 's'));
  }
}}
